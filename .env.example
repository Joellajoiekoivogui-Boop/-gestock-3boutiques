# MassaGui Fils SARL.U — variables d'environnement
# Copiez ce fichier en .env.local (jamais commité) et remplacez les valeurs.
# Supabase : Project Settings → API.

# URL du projet Supabase (publique)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé « anon » ou « publishable » (publique : la sécurité repose sur RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé « service_role » / « secret » — SERVEUR UNIQUEMENT.
# Sert uniquement à créer les comptes, changer un mot de passe et bloquer un
# compte désactivé. Ne la préfixez JAMAIS par NEXT_PUBLIC_ et ne la commitez pas.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete
