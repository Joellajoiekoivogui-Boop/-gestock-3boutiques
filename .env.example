# Variables d'environnement de l'authentification (fonctions serveur Vercel).
# En production/préproduction elles sont définies dans Vercel (Project Settings → Environment Variables).
# En local, `vercel dev` les récupère automatiquement depuis le projet lié.

# Secret de signature des jetons de session (>= 32 octets aléatoires, en hex)
AUTH_SECRET=

# Comptes, mots de passe hachés (scrypt). Tableau JSON :
# [{"id","name","email","role":"admin|gerant","boutiqueId","pw":"<selHex>:<hashHex>"}]
AUTH_USERS=
